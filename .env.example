# Copy to .env and fill in. Secrets stay local; .env is gitignored.

# --- Chat provider (local-first default: anthropic) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Per-role models — tier separation (see PLAN.md section 7).
ROUTER_MODEL=claude-haiku-4-5
RETRIEVER_MODEL=claude-sonnet-4-6
# Researcher = the heavy Anthropic Opus tier; set your chosen model id here:
RESEARCHER_MODEL=

# --- Embeddings (separate provider; optional in Inc 0) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Alternate provider: Azure OpenAI (boilerplate) ---
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# Point ROUTER/RETRIEVER/RESEARCHER_MODEL at your GPT-4o deployment name when using Azure.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
