# Copy to .env and fill in. Secrets stay local; .env is gitignored.

# --- Chat provider (local-first default: anthropic) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Per-role models — tier separation (ANTHROPIC only; ignored when LLM_PROVIDER=azure_openai,
# which maps every role to AZURE_OPENAI_MODEL_GPT4O below). See PLAN.md section 7.
ROUTER_MODEL=claude-haiku-4-5
RETRIEVER_MODEL=claude-sonnet-4-6
# Researcher = the heavy Anthropic Opus tier; set your chosen model id here:
RESEARCHER_MODEL=

# --- Embeddings (powers semantic doc RAG; additive — falls back to keyword if unavailable) ---
# If AZURE_OPENAI_MODEL_ADA2 (+ Azure endpoint below) is set, ada-2 is used automatically for
# embeddings — regardless of the chat provider, and you do NOT need to set EMBEDDING_PROVIDER.
AZURE_OPENAI_MODEL_ADA2=                 # your text-embedding-ada-002 deployment name -> used whenever set
# EMBEDDING_PROVIDER=none                # only to DISABLE embeddings (keyword-only doc search)
# EMBEDDING_PROVIDER=local              # force local sentence-transformers (needs `uv sync --extra semantic`)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # used only when EMBEDDING_PROVIDER=local

# --- Azure OpenAI (boilerplate) — needed for ada-2 embeddings AND/OR Azure chat ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=
# Entra-ID service principal (shared by chat + embeddings):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# For Azure CHAT: set LLM_PROVIDER=azure_openai and ONE chat deployment — all agent roles use it
# (no need to touch ROUTER/RETRIEVER/RESEARCHER_MODEL):
# AZURE_OPENAI_MODEL_GPT4O=             # your gpt-4o chat deployment name

# --- External professional corpus (optional reference docs; or pass --corpus <dir>) ---
# CORPUS_PATH=/path/to/reference/docs

# --- Web search for the researcher (budgeted; keyless DuckDuckGo by default) ---
WEB_SEARCH_PROVIDER=duckduckgo      # duckduckgo (keyless) | tavily (needs key) | none (disable egress)
# TAVILY_API_KEY=                   # only for WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_MAX=3                  # max web searches per question
