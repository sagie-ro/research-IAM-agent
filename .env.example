# Copy to .env and fill in the blanks. Secrets stay local; .env is gitignored.
# Active provider below is Azure OpenAI. To use Anthropic instead, set LLM_PROVIDER=anthropic.

# ── Provider ────────────────────────────────────────────────────────────────────
LLM_PROVIDER=azure_openai #Anthropic

# ── Azure OpenAI (chat + embeddings; Entra-ID service principal) ─────────────────
# Chat: ONE deployment serves every agent role (router / retriever / researcher).
AZURE_OPENAI_MODEL_GPT4o=gpt-4o-exercise
# Embeddings: ada-2 is used automatically whenever this is set (powers semantic doc RAG),
# regardless of provider. Leave the GPT4o line for chat, this one for embeddings.
AZURE_OPENAI_MODEL_ADA2=ada-exercise
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=

AZURE_CLIENT_SECRET=

# ── Anthropic (used only when LLM_PROVIDER=anthropic) ────────────────────────────
ANTHROPIC_API_KEY=
ROUTER_MODEL=claude-haiku-4-5
RETRIEVER_MODEL=claude-haiku-4-5
RESEARCHER_MODEL=claude-haiku-4-5

# ── Embeddings knobs (optional; ada-2 above is used automatically when set) ──────
# EMBEDDING_PROVIDER=none               # disable embeddings (keyword-only doc search)
# EMBEDDING_PROVIDER=local              # local sentence-transformers (needs: uv sync --extra semantic)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Web search for the researcher (budgeted; keyless DuckDuckGo by default) ──────
WEB_SEARCH_PROVIDER=duckduckgo          # duckduckgo (keyless) | tavily (needs key) | none
# TAVILY_API_KEY=                       # only for WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_MAX=3                      # max web searches per question

# ── External professional corpus (optional reference docs; or pass --corpus <dir>) ─
# CORPUS_PATH=/path/to/reference/docs
